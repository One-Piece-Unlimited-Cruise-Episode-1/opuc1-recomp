<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>opuc1-recomp-setup</AssemblyName>
    <RootNamespace>Opuc1Recomp.Setup.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Authors>One Piece: Unlimited Recompilation Episode 1 contributors</Authors>
    <Product>One Piece: Unlimited Recompilation Episode 1</Product>
    <Description>Setup and launcher for One Piece: Unlimited Recompilation Episode 1</Description>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- Released as a Native AOT executable (Build-Installer.ps1: dotnet publish -r win-x64); plain
       builds stay JIT. PublishAot also runs the trim/AOT analyzers on every build. The feature
       switches drop runtime code the setup never uses. -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <!-- Trim/AOT analyzer findings fail the build instead of shipping a host that breaks at run time. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- LibraryImport / GeneratedComInterface (ShellIntegration) emit unsafe marshalling stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <MetricsSupport>false</MetricsSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <Http3Support>false</Http3Support>
    <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Opuc1Recomp.Setup.Common\Opuc1Recomp.Setup.Common.csproj" />
    <Using Include="Opuc1Recomp.Setup.Common" />
  </ItemGroup>
</Project>
